<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/download__4_"
    tools:context=".changePass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">




        <ImageView
            android:id="@+id/close1"
            android:layout_width="134dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-30dp"
            android:layout_marginTop="25dp"
            app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#ffff" />


        <TextView
            android:id="@+id/check_mail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="15dp"
            android:text="Password Reset"
            android:textColor="@color/white"
            android:textSize="35dp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_marginStart="10dp"
            android:text="Would you like to change your password. Please confirm. "
            android:padding="13dp"
            android:textSize="19dp"
            android:textStyle="bold"
            android:lineSpacingExtra="8dp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif"
            />


        <Button
            android:id="@+id/Confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="53dp"
            android:layout_marginTop="80dp"
            android:padding="12dp"
            android:text="Confirm"
            android:textSize="20sp"
            app:backgroundTint="#525754"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView4" />











    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>