<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#F8E2E2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".otp_pg">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/close2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-350dp"
            android:layout_marginTop="25dp"
            app:tint="#000000"
            app:srcCompat="@android:drawable/ic_menu_close_clear_cancel" />




        <TextView
            android:id="@+id/check_mail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp"
            android:text="  Check Your mail"
            android:textSize="35dp"
            android:textStyle="bold" />




        <TextView
            android:id="@+id/check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp"
            android:text="We sent reset link to KNP******@gmail.com. Enter 5 digit code that mentioned in the email"
            android:textSize="19dp"
            android:textStyle="bold"
            android:lineSpacingExtra="8dp"
            android:fontFamily="sans-serif"
            />


    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/otp1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="235dp"
            android:layout_marginEnd="37dp"
            android:background="@drawable/otp_bg"
            android:padding="20dp"
            android:textSize="18dp"
            android:textStyle="bold"
            android:hint="OTP CODE..."

            />







    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Button
            android:id="@+id/vertify2"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="53dp"
            android:layout_marginTop="330dp"
            android:padding="12dp"
            android:text="Vertify Code"
            android:textSize="20sp"
            app:backgroundTint="#525754"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView4" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="85dp"
            android:layout_marginEnd="0dp"
            android:hint="Haven't got the email yet?"
            android:textSize="17sp"
            android:padding="15dp"
            android:layout_marginTop="40dp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            />.

        <TextView
            android:id="@+id/Resend2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="145dp"
            android:layout_marginEnd="0dp"
            android:text="Resend Email"
            android:textSize="17sp"
            android:padding="0dp"

            android:textColor="#494bd1"
            android:layout_marginTop="0dp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            />.







        />









    </LinearLayout>












</androidx.constraintlayout.widget.ConstraintLayout>