<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="#F8E2E2"
    android:layout_height="match_parent"
    tools:context=".Home_pg">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="69dp"
            android:layout_height="90dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:id="@+id/menu"
            app:srcCompat="@drawable/menu_icon_6"

            />



    </LinearLayout>





    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >



        <ImageView
            android:id="@+id/user"
            android:layout_width="115dp"
            android:layout_height="50dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="300dp"
            app:layout_constraintHorizontal_bias="10"
            app:srcCompat="@drawable/_682281"

            />
    </LinearLayout>


    <LinearLayout

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/user2"
            android:layout_width="150dp"
            android:layout_height="88dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="250dp"
            android:text="Welcome\n   Kaveen"
            android:textSize="20dp"
            android:textStyle="italic|bold"
            android:fontFamily="sans-serif"
            />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <TextView
            android:id="@+id/To_Do"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="100dp"
            android:layout_marginTop="120dp"
            android:text="To Do List"
            android:textSize="45dp"
            android:textStyle="bold" />

        <Button
            android:layout_width="368dp"
            android:layout_height="131dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/todo_bg"
            android:text="Personal and home list"
            android:textColor="@color/black"
            android:textSize="20dp"
            app:backgroundTint="@null" />

        <Button
            android:layout_width="368dp"
            android:layout_height="137dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/todo_bg"
            android:text="Office work list"
            android:textColor="@color/black"
            android:textSize="20dp"
            app:backgroundTint="@null" />

        <Button
            android:layout_width="368dp"
            android:layout_height="130dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/todo_bg"
            android:text="+Demo"
            android:textColor="@color/black"
            android:textSize="20dp"
            app:backgroundTint="@null" />


        <Button
            android:id="@+id/Add_list"
            android:layout_width="368dp"
            android:layout_height="70dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="20dp"
            android:text="+Add list"
            android:textColor="@color/white"
            android:textSize="20dp"
            app:backgroundTint="#525754"/>



    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>